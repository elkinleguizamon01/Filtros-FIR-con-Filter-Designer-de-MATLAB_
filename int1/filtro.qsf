set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "17:53:19  SEPTEMBER 29, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1

# ============================================================
# Archivos VHDL del proyecto
# ============================================================
set_global_assignment -name VHDL_FILE gen_muestreo.vhd
set_global_assignment -name VHDL_FILE adc0808_reader.vhd
set_global_assignment -name VHDL_FILE FIR_Filter.vhd
set_global_assignment -name VHDL_FILE bin_a_bcd.vhd
set_global_assignment -name VHDL_FILE hex7seg.vhd
set_global_assignment -name VHDL_FILE top_lab2.vhd

# ============================================================
# Cambiar top-level a top_lab2
# ============================================================
set_global_assignment -name TOP_LEVEL_ENTITY top_lab2

# ============================================================
# ASIGNACION DE PINES - DE1 (Cyclone II EP2C20F484C7)
# Laboratorio 2 - Filtro FIR con perturbacion coherente
# Semilla S = 64
# ============================================================

# ===== Reloj del sistema =====
set_location_assignment PIN_L1 -to CLOCK_50

# ===== Reset (KEY0) =====
set_location_assignment PIN_R22 -to KEY[0]
set_location_assignment PIN_R21 -to KEY[1]
set_location_assignment PIN_T22 -to KEY[2]
set_location_assignment PIN_T21 -to KEY[3]

# ===== Interruptores =====
set_location_assignment PIN_L22 -to SW[0]
set_location_assignment PIN_L21 -to SW[1]
set_location_assignment PIN_M22 -to SW[2]
set_location_assignment PIN_V12 -to SW[3]
set_location_assignment PIN_W12 -to SW[4]
set_location_assignment PIN_U12 -to SW[5]
set_location_assignment PIN_U11 -to SW[6]
set_location_assignment PIN_M2 -to SW[7]
set_location_assignment PIN_M1 -to SW[8]
set_location_assignment PIN_L2 -to SW[9]

# ===== LEDs rojos =====
set_location_assignment PIN_R20 -to LEDR[0]
set_location_assignment PIN_R19 -to LEDR[1]
set_location_assignment PIN_U19 -to LEDR[2]
set_location_assignment PIN_Y19 -to LEDR[3]
set_location_assignment PIN_T18 -to LEDR[4]
set_location_assignment PIN_V19 -to LEDR[5]
set_location_assignment PIN_Y18 -to LEDR[6]
set_location_assignment PIN_U18 -to LEDR[7]
set_location_assignment PIN_R18 -to LEDR[8]
set_location_assignment PIN_R17 -to LEDR[9]

# ===== Displays 7 segmentos =====
# HEX0
set_location_assignment PIN_J2 -to HEX0[0]
set_location_assignment PIN_J1 -to HEX0[1]
set_location_assignment PIN_H2 -to HEX0[2]
set_location_assignment PIN_H1 -to HEX0[3]
set_location_assignment PIN_F2 -to HEX0[4]
set_location_assignment PIN_F1 -to HEX0[5]
set_location_assignment PIN_E2 -to HEX0[6]

# HEX1
set_location_assignment PIN_E1 -to HEX1[0]
set_location_assignment PIN_H6 -to HEX1[1]
set_location_assignment PIN_H5 -to HEX1[2]
set_location_assignment PIN_H4 -to HEX1[3]
set_location_assignment PIN_G3 -to HEX1[4]
set_location_assignment PIN_D2 -to HEX1[5]
set_location_assignment PIN_D1 -to HEX1[6]

# HEX2
set_location_assignment PIN_G5 -to HEX2[0]
set_location_assignment PIN_G6 -to HEX2[1]
set_location_assignment PIN_C2 -to HEX2[2]
set_location_assignment PIN_C1 -to HEX2[3]
set_location_assignment PIN_E3 -to HEX2[4]
set_location_assignment PIN_E4 -to HEX2[5]
set_location_assignment PIN_D3 -to HEX2[6]

# HEX3
set_location_assignment PIN_F4 -to HEX3[0]
set_location_assignment PIN_D5 -to HEX3[1]
set_location_assignment PIN_D6 -to HEX3[2]
set_location_assignment PIN_J4 -to HEX3[3]
set_location_assignment PIN_L8 -to HEX3[4]
set_location_assignment PIN_F3 -to HEX3[5]
set_location_assignment PIN_D4 -to HEX3[6]

# ===== GPIO_0 (Expansion Header JP1) =====
# Salidas hacia el exterior

# Entradas desde el exterior

# DATA[7:0] del ADC0808


# DAC R-2R (salidas) - 8 bits
set_location_assignment PIN_B20 -to GPIO_0[15]


# ===== Opciones globales =====
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name GENERATE_RBF_FILE ON


set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# ============================================================
# GPIO_0 (Expansion Header JP1) - DE1 Tabla 4.7
# ============================================================

# Salidas (15 bits)
set_location_assignment PIN_A13 -to GPIO_0_OUT[0]
set_location_assignment PIN_B13 -to GPIO_0_OUT[1]
set_location_assignment PIN_A14 -to GPIO_0_OUT[2]
set_location_assignment PIN_B14 -to GPIO_0_OUT[3]
set_location_assignment PIN_A15 -to GPIO_0_OUT[4]
set_location_assignment PIN_B15 -to GPIO_0_OUT[5]
set_location_assignment PIN_A16 -to GPIO_0_OUT[6]

# DAC R-2R (salidas) - 8 bits
set_location_assignment PIN_B20 -to GPIO_0_OUT[7]
set_location_assignment PIN_C21 -to GPIO_0_OUT[8]
set_location_assignment PIN_C22 -to GPIO_0_OUT[9]
set_location_assignment PIN_D21 -to GPIO_0_OUT[10]
set_location_assignment PIN_D22 -to GPIO_0_OUT[11]
set_location_assignment PIN_E21 -to GPIO_0_OUT[12]
set_location_assignment PIN_E22 -to GPIO_0_OUT[13]
set_location_assignment PIN_F21 -to GPIO_0_OUT[14]

# Entradas (8 bits: eoc + data[0..6])
set_location_assignment PIN_B16 -to GPIO_0_IN[0]
set_location_assignment PIN_A17 -to GPIO_0_IN[1]
set_location_assignment PIN_B17 -to GPIO_0_IN[2]
set_location_assignment PIN_A18 -to GPIO_0_IN[3]
set_location_assignment PIN_B18 -to GPIO_0_IN[4]
set_location_assignment PIN_A19 -to GPIO_0_IN[5]
set_location_assignment PIN_B19 -to GPIO_0_IN[6]
set_location_assignment PIN_A20 -to GPIO_0_IN[7]

# ============================================================
# GPIO_1 (Expansion Header JP2) - DE1 Tabla 4.7
# Solo se usa 1 pin para data[7] del ADC
# ============================================================
set_location_assignment PIN_H14 -to GPIO_1_IN[0]

# Pines no usados (23 a 35) -> tri-state
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[23]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[24]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[25]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[26]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[27]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[28]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[29]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[30]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[31]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[32]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[33]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[34]
set_instance_assignment -name RESERVE_PIN "AS INPUT TRI-STATED" -to GPIO_0[35]

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top